<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.rdbot</groupId>
    <artifactId>rdbot</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>RD-Bot</name>
    <description>Discord support bot: Groq AI answers inside tickets, knowledge base, token-protected web panel.</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jda.version>5.2.2</jda.version>
        <jackson.version>2.17.2</jackson.version>
        <paper.version>1.21.11-R0.1-SNAPSHOT</paper.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Server API. Provided: never shaded, it is on the server already. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
          Discord. Everything here is shaded in, so the exclusions below are what
          keep the jar small. All of them were verified against the JDA 5.2.2
          bytecode: each is referenced only from net/dv8tion/jda/internal/audio/
          (jna, opus, tink) or from nothing at all (protobuf). This bot requests
          GUILD_MESSAGES and MESSAGE_CONTENT only - no voice gateway, so the
          voice stack is unreachable.
        -->
        <dependency>
            <groupId>net.dv8tion</groupId>
            <artifactId>JDA</artifactId>
            <version>${jda.version}</version>
            <exclusions>
                <!-- Server bundles SLF4J. Shipping slf4j-simple inside a
                     plugin would hijack the whole server's logging. -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
                <!-- Voice only (internal/audio/Decoder, AudioConnection). -->
                <exclusion>
                    <groupId>net.java.dev.jna</groupId>
                    <artifactId>jna</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>club.minnced</groupId>
                    <artifactId>opus-java</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>club.minnced</groupId>
                    <artifactId>opus-java-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>club.minnced</groupId>
                    <artifactId>opus-java-natives</artifactId>
                </exclusion>
                <!-- Voice-only crypto (internal/audio/CryptoAdapter). -->
                <exclusion>
                    <groupId>com.google.crypto.tink</groupId>
                    <artifactId>tink</artifactId>
                </exclusion>
                <!-- Pulled in only by tink; referenced by zero JDA classes. -->
                <exclusion>
                    <groupId>com.google.protobuf</groupId>
                    <artifactId>protobuf-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--
          JSON. Gson and commons-collections4 arrive with the Paper server and
          would only risk a version clash, so both are provided.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!--
          Storage. Paper bundles sqlite-jdbc (3.49.x). Shipping our own copy
          would add ~6 MB of native libraries to duplicate a class the server
          already loads - and the natives are what break when they mismatch.
        -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- SnakeYAML 2.2 is bundled by Paper. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.2</version>
            <scope>provided</scope>
        </dependency>

        <!-- Web scraping for the knowledge base. -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.19.1</version>
        </dependency>

        <!-- PDF ingestion for the knowledge base. -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>2.0.32</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>RD-Bot</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <!-- Keeps the standalone `java -jar RD-Bot.jar`
                                     form working alongside the plugin form. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>dev.rdbot.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/*.txt</exclude>
                                        <exclude>META-INF/*.html</exclude>
                                        <exclude>META-INF/maven/**</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <!-- Server-provided, must not be duplicated. -->
                                        <exclude>org/sqlite/**</exclude>
                                        <exclude>org/yaml/snakeyaml/**</exclude>
                                        <exclude>com/google/gson/**</exclude>
                                        <!-- PDF text extraction does not need colour profiles. -->
                                        <exclude>org/apache/pdfbox/resources/icc/*</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>