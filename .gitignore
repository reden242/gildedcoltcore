# Everything not part of the two plugins + docs is workspace scratch.
#
# The rule below is a deny-all with an explicit allow-list, so only the two
# plugin trees, the antiad training directory and the docs are tracked - 130
# files out of roughly 23,000 in the workspace.
#
# What that means in practice: the other ~22,870 files are excluded by
# inference from `*`, not by any rule that names them. They are genuinely
# absent from the repository, but a `git log`/`git grep`-based secret or
# vulnerability sweep will see only the 130 tracked files and report a clean
# result on a workspace it never looked at. Scan the filesystem, not the
# history, when auditing this workspace.
#
# Named here so the exclusions are visible rather than derived:
#
#   base/                          local scratch tree, cheat research
#   GildedCore-final/com/kammoun/  decompiled third-party dump (~14,400 files)
#   ColtCore/diag/                 generated diagnostics, wrong package name
#   verify-temp*/                  scratch verification builds
#   antiad/classes/                compiled scratch output for the trainers
#   */target/                      Maven build output
#
# If any of those ever needs to ship, add an explicit `!` allow-list entry
# for it, the way the plugin trees below are handled.
*
!ColtCore/
!ColtCore/src/
!ColtCore/src/main/
!ColtCore/src/main/java/
!ColtCore/src/main/java/com/
!ColtCore/src/main/java/com/coltcore/
!ColtCore/src/main/java/com/coltcore/core/
!ColtCore/src/main/java/com/coltcore/core/modules/
!ColtCore/src/main/java/com/coltcore/core/*.java
!ColtCore/src/main/java/com/coltcore/core/modules/*.java
!ColtCore/src/main/resources/
!ColtCore/src/main/resources/**
!ColtCore/pom.xml
!GildedCore-final/
!GildedCore-final/src/
!GildedCore-final/src/main/
!GildedCore-final/src/main/java/
!GildedCore-final/src/main/java/com/
!GildedCore-final/src/main/java/com/gildedmc/
!GildedCore-final/src/main/java/com/gildedmc/core/
!GildedCore-final/src/main/java/com/gildedmc/core/modules/
!GildedCore-final/src/main/java/com/gildedmc/core/*.java
!GildedCore-final/src/main/java/com/gildedmc/core/modules/*.java
!GildedCore-final/src/main/resources/
!GildedCore-final/src/main/resources/**
!GildedCore-final/pom.xml
# RD-Bot: standalone Discord support bot, now shipped as a Paper plugin. Same
# allow-list treatment as the two plugin trees - it is a real Maven project, not
# scratch. config.yml, rdbot.db and panel-tokens.json are runtime files and stay
# out (the allow-list below only names the example config and the sources).
!RD-Bot/
!RD-Bot/src/
!RD-Bot/src/main/
!RD-Bot/src/main/java/
!RD-Bot/src/main/java/dev/
!RD-Bot/src/main/java/dev/rdbot/
!RD-Bot/src/main/java/dev/rdbot/*.java
!RD-Bot/src/main/java/dev/rdbot/ai/
!RD-Bot/src/main/java/dev/rdbot/ai/*.java
!RD-Bot/src/main/java/dev/rdbot/discord/
!RD-Bot/src/main/java/dev/rdbot/discord/*.java
!RD-Bot/src/main/java/dev/rdbot/kb/
!RD-Bot/src/main/java/dev/rdbot/kb/*.java
!RD-Bot/src/main/java/dev/rdbot/store/
!RD-Bot/src/main/java/dev/rdbot/store/*.java
!RD-Bot/src/main/java/dev/rdbot/web/
!RD-Bot/src/main/java/dev/rdbot/web/*.java
!RD-Bot/src/main/resources/
!RD-Bot/src/main/resources/**
!RD-Bot/pom.xml
!RD-Bot/README.md
!RD-Bot/config.example.yml
!antiad/
!antiad/*.py
!antiad/*.java
!antiad/*.tsv
!antiad/*.txt
!antiad/*.md
!README.md
!.gitignore

# ---- agent memory and the code graph -------------------------------------
# memory.md is the running development log; graphify-out/ is the generated
# knowledge graph of this workspace. Both are wanted in history so a change can
# be read against what was known at the time.
#
# graphify-out/cache/ is deliberately NOT tracked: 269 files, 34MB, entirely
# regenerable by `graphify update .`. Same for the dated snapshot directories,
# which are just a copy of the current graph.
!memory.md
!graphify-out/
!graphify-out/GRAPH_REPORT.md
!graphify-out/manifest.json
!graphify-out/graph.json
!graphify-out/graph.html
!graphify-out/.graphify_root
!graphify-out/.graphify_labels.json
!graphify-out/.graphify_labels.json.sig
# Explicitly re-assert the exclusions, because the deny-all above would
# otherwise have to be re-derived for anyone reading this file.
graphify-out/cache/
graphify-out/*/
